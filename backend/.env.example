# New deployments only. Never overwrite an existing private .env.
# Provider endpoints, limits and CNY rates: config/models/providers.json.
# Roles below override JSON roles; model defaults: config/models/Models.json.
TEXT_MAIN_PROVIDER=deepseek
TEXT_MAIN_MODEL=deepseek-flash
TEXT_MAIN_API_KEY=
TEXT_LITERATURE_PROVIDER=deepseek
TEXT_LITERATURE_MODEL=deepseek-v4-pro
TEXT_LITERATURE_API_KEY=
TEXT_PROCESS_PROVIDER=siliconflow
TEXT_PROCESS_MODEL=deepseek-ai/DeepSeek-V3.2
TEXT_PROCESS_API_KEY=
# Native Search uses official DeepSeek Anthropic independently of the teaching provider.
# If main=deepseek, its key is used when the search key is absent.
TEXT_SEARCH_MODEL=deepseek-flash
TEXT_SEARCH_API_KEY=

IMAGE-API=
IMAGE-KEY=
IMAGE-MODELID=gpt-image-2.5
IMAGE-CREDIT=0
# Optional secrets; generated local student JWT key if unset.
# JWT_SECRET=
# ADMIN_PASSWORD_HASH=        # Argon2 hash only; normally main.py --set-admin-password
# Paths, CORS, TLS, retention and execution limits belong in config/runtime/*.json.
# Offline curriculum assets: config/runtime/syllabus.json; data/syllabus is not committed.
# SYNAXIS_CONFIG_DIR=/absolute/path/to/config
# DATA_DIR=/absolute/path/to/private/data
# Legacy DEEPSEEK-APIKEY/MODELID-* and SILICONFLOW-APIKEY/MODELID-PROCESS
# remain accepted during migration. SANDBOX_URL/KEY are retired; no port 8766.
