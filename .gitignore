# Secrets: never publish real environments, credentials, certificates or runtime data.
.env
.env.*
*.env
*.env.*
!.env.example
*.key
*.pem
*.p12
*.pfx
*.jks
*.keystore
*.sqlite
*.sqlite3
*.sqlite3-*
*.db
*.db-*
.secrets/
# Python and build caches
.venv/
.venv-*/
.uv-cache/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.coverage*
htmlcov/
# Backend private evidence, backups and installed runtimes
backend/data/
backend/test-results/
backend/dist/
backend/archive/
backend/deploy-backups/
backend/vendor/
backend/rootfs/
backend/.tools/
backend/.python/
backend/.sandbox.env
